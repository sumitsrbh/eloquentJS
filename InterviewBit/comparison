function printGrade(fn, num) {
  if (num >= 90) {
    fn('A')
  } else if (num >= 80) {
    fn('B')
  } else if (num >= 70) {
    fn('C')
  } else if (num >= 60) {
    fn('D')
  } else if (num >= 50) {
    fn('E')
  } else {
    fn('F')
  }
}
printGrade(console.log(), 59)

